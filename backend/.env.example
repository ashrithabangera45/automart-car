# Server & Environment Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/car_ecommerce

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Gmail SMTP Configuration for AutoMart Password Reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password
EMAIL_FROM=your_gmail_address@gmail.com

# Contact & Admin Notification Receivers
CONTACT_RECEIVER=admin@automart.com
ADMIN_NOTIFICATION_EMAIL=admin@automart.com
